{
  "name": "captraw",
  "version": "0.65.0-beta.1",
  "private": true,
  "description": "A local, non-destructive RAW development workbench",
  "license": "GPL-3.0-or-later",
  "author": "CaptRAW Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/He0xD4C0/CaptRAW.git"
  },
  "homepage": "https://github.com/He0xD4C0/CaptRAW",
  "bugs": {
    "url": "https://github.com/He0xD4C0/CaptRAW/issues"
  },
  "type": "module",
  "main": "apps/desktop/dist/electron/main.cjs",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "candidate:build": "node scripts/candidate.mjs build",
    "candidate:verify": "node scripts/candidate.mjs verify",
    "candidate:check": "node scripts/candidate.mjs check",
    "candidate:report": "node scripts/candidate.mjs report",
    "candidate:suite": "node scripts/candidate.mjs suite",
    "dev": "node scripts/dev.mjs",
    "build:ui": "turbo run build --filter=@captraw/desktop...",
    "build:native": "node scripts/build-native.mjs",
    "build:app": "node scripts/verify-app-build.mjs",
    "build": "turbo run build:app",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:unit",
    "test:unit": "node scripts/test-suite.mjs run unit --dev-unverified",
    "test:suite": "node scripts/test-suite.mjs run",
    "test:gate": "node scripts/test-suite.mjs gate",
    "test:affected": "node scripts/test-suite.mjs affected",
    "ci:check": "turbo run build typecheck test:unit",
    "prepare:electron": "install-electron",
    "package": "pnpm prepare:electron && pnpm build && node scripts/make-icon.mjs && node scripts/bundle-native.mjs && node scripts/bundle-segmentation.mjs && electron-builder --mac --arm64 --publish never",
    "test:e2e": "pnpm prepare:electron && node scripts/test-suite.mjs run e2e.smoke",
    "test:e2e:dev": "pnpm prepare:electron && pnpm build:ui && node scripts/test-suite.mjs run e2e.smoke --dev-unverified",
    "test:e2e:performance": "pnpm prepare:electron && CAPTRAW_E2E_PERF_BUDGET_MS=5000 node scripts/test-suite.mjs run e2e.smoke",
    "build:xmp": "node scripts/build-xmp.mjs"
  },
  "devDependencies": {
    "@captraw/contracts": "workspace:*",
    "@captraw/desktop-core": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.27.0",
    "typescript": "7.0.2",
    "turbo": "2.11.10"
  },
  "build": {
    "appId": "org.captraw.desktop",
    "productName": "CaptRAW",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/bundle/native",
        "to": "native"
      },
      {
        "from": "build/bundle/segmentation",
        "to": "segmentation"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": "-",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "26.0.0"
    },
    "dmg": {
      "title": "CaptRAW 0.65.0-beta.1"
    }
  }
}
