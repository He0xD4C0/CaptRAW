{
  "name": "captraw",
  "version": "0.41.0",
  "private": true,
  "description": "A local, non-destructive RAW development workbench",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "apps/desktop/dist/electron/main.cjs",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:ui": "turbo run build --filter=@captraw/desktop...",
    "build:native": "node scripts/build-native.mjs",
    "build": "pnpm build:native && pnpm build:xmp && pnpm build:ui",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:unit",
    "test:unit": "node --test tests/*.test.mjs",
    "ci:check": "turbo run build typecheck test:unit",
    "prepare:electron": "install-electron",
    "package": "pnpm prepare:electron && pnpm build && node scripts/make-icon.mjs && node scripts/bundle-native.mjs && node scripts/bundle-segmentation.mjs && electron-builder --mac --arm64 --publish never",
    "test:e2e": "pnpm prepare:electron && pnpm build:ui && node tests/e2e.mjs",
    "test:e2e:performance": "pnpm prepare:electron && pnpm build:ui && CAPTRAW_E2E_PERF_BUDGET_MS=5000 node tests/e2e.mjs",
    "build:xmp": "node scripts/build-xmp.mjs"
  },
  "devDependencies": {
    "@captraw/contracts": "workspace:*",
    "@captraw/desktop-core": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.27.0",
    "typescript": "7.0.2",
    "turbo": "2.11.10"
  },
  "build": {
    "appId": "org.captraw.desktop",
    "productName": "CaptRAW",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/bundle/native",
        "to": "native"
      },
      {
        "from": "build/bundle/segmentation",
        "to": "segmentation"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": "-",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "26.0.0"
    },
    "dmg": {
      "title": "CaptRAW 0.41.0"
    }
  }
}
